# --- Core runtime ---
SKYSNAP_DB_PATH=./data/skysnap.sqlite
# Kompass get-contact reveals per CALENDAR DAY (persisted in SQLite across runs).
# Reveals always go to the highest-ICP pending leads first; the firm-page
# contact (address, NIP, phone, email) is scraped for free on every lead.
SKYSNAP_DAILY_LIMIT=5
SKYSNAP_MIN_SCORE=40
# Export without email/phone when ICP >= this and GW/investor company is identified (Kompass tier)
SKYSNAP_STAKEHOLDER_EXPORT_MIN_ICP=60
SKYSNAP_USER_AGENT=SkySnapLeadBot/1.0 (+https://example.invalid)

# --- Contact denylist (avoid leaking the platform/self contact) ---
# Kompass renders the logged-in account (KOMPASS_USERNAME is auto-blocked) and a
# platform switchboard on nearly every page. These extend the built-in defaults
# (skysnap.pl, pawel.wojcik@skysnap.pl, +48 22 633 26 85). Comma-separated.
SKYSNAP_BLOCKED_EMAILS=pawel.wojcik@skysnap.pl
SKYSNAP_BLOCKED_EMAIL_DOMAINS=skysnap.pl
SKYSNAP_BLOCKED_PHONES=+48 22 633 26 85 
SKYSNAP_BLOCKED_WEBSITE_HOSTS=skysnap.pl

# --- Anthropic / Claude ---
# Create at https://console.anthropic.com/settings/keys (one line, no quotes).
# Run: python -m skysnap check-config
ANTHROPIC_API_KEY=
SKYSNAP_CLAUDE_MODEL=claude-sonnet-4-20250514
# Daily Claude token/cost log (JSON lines per day)
SKYSNAP_CLAUDE_USAGE_LOG_DIR=./data/logs
# USD per million tokens (adjust to match your model/pricing)
CLAUDE_PRICE_INPUT_PER_MTOK=3.0
CLAUDE_PRICE_OUTPUT_PER_MTOK=15.0

# --- NVIDIA NIM (OpenAI-compatible fallback when Claude is unavailable) ---
# API key from https://build.nvidia.com/ (starts with nvapi-)
NVIDIA_API_KEY=
# Optional: override default model in scripts/test_nvidia_nim.py
# NVIDIA_NIM_MODEL=meta/llama-3.3-70b-instruct

# --- IMAP ingestion (e.g. Gmail / Microsoft / custom) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=xxxxy@gmail.com
IMAP_PASSWORD=xxxxxxxxxxxxxx (16 characters)
IMAP_FOLDER=INBOX
# Standard IMAP (works on most providers):
# IMAP_SEARCH_QUERY=(UNSEEN SUBJECT "Informacja o nowych inwestycjach")
# Gmail: INBOX often has 0 IMAP UNSEEN even when the web UI shows unread. Use Gmail raw search instead:
IMAP_SEARCH_QUERY=X-GM-RAW:inwestycjach

# --- HubSpot (optional: dedupe read + lead push write) ---
# Read scope: crm.objects.companies.read
# Write scopes (for push-hubspot): crm.objects.companies.write,
#   crm.objects.contacts.write, crm.objects.deals.write, crm.objects.tasks.write
HUBSPOT_PRIVATE_APP_TOKEN=
# Enable HubSpot write sync after sheet export (requires write scopes above)
SKYSNAP_HUBSPOT_PUSH_ENABLED=false
# Internal HubSpot IDs (Settings → Objects → Deals → Pipelines)
HUBSPOT_DEAL_PIPELINE_ID=
HUBSPOT_DEAL_STAGE_ID=
# Contact-lead task created on each push (requires crm.objects.tasks.write)
SKYSNAP_HUBSPOT_CREATE_TASK=true
# always | personal_contact (only when a HubSpot Contact was created)
SKYSNAP_HUBSPOT_TASK_WHEN=always
# HubSpot user ID (Settings → Users & Teams → user → ID in URL)
HUBSPOT_TASK_OWNER_ID=
HUBSPOT_TASK_TYPE=CALL
HUBSPOT_TASK_DUE_DAYS=1
# Optional custom property internal names (leave blank to skip)
HUBSPOT_PROP_PROJECT_URL=
HUBSPOT_PROP_ICP_SCORE=
HUBSPOT_PROP_LEADS_ORIGIN=
HUBSPOT_PROP_STAGE_INWESTYCJI=
HUBSPOT_PROP_NIP=

# --- Project similarity (HubSpot deals read) ---
SKYSNAP_PROJECT_SIMILARITY_ENABLED=true
# Komentarz note when similarity >= this (0 = use 60 for notes only)
SKYSNAP_PROJECT_SIMILARITY_MIN_SCORE=0

# --- Google Sheets (sole destination) ---
# Enable Google Sheets API in the same GCP project as the service account.
# Share the sheet with the service account client_email (Editor).
GOOGLE_SERVICE_ACCOUNT_JSON=./credentials.json
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB_NAME=Leads

# --- Kompass authenticated enrichment (top 5 contacts found / day) ---
KOMPASS_USERNAME=
KOMPASS_PASSWORD=
KOMPASS_BASE_URL=https://www.kompasinwestycji.pl
KOMPASS_LOGIN_PATH=/zaloguj
KOMPASS_BROWSER_STATE_DIR=./data/kompass_browser_state
# Set to false if headless login is blocked (CAPTCHA)
KOMPASS_HEADLESS=true
# --- Daily run timezone + OSINT cap ---
SKYSNAP_TIMEZONE=Europe/Warsaw
# Optional cap on OSINT leads per run (unset = all remaining pending after Kompass)
# SKYSNAP_OSINT_DAILY_CAP=10

# --- OSINT contact enrichment (Tier 0 + Tier 1, all free) ---
# How many contact/team/bidding-dept subpages to crawl per company site (0 = landing only)
SKYSNAP_OSINT_MAX_SUBPAGES=4
# Validate that an email's domain accepts mail (MX lookup). Set false for offline/air-gapped runs.
SKYSNAP_EMAIL_MX_CHECK=true
# Infer a likely personal email from name + verified company domain when none is found
SKYSNAP_EMAIL_PATTERN_GUESS=true
# Optional, free key for GUS BIR (REGON) registry lookups. Leave blank to disable.
# Register at https://api.stat.gov.pl/Home/RegonApi
GUS_BIR_API_KEY=

